# Copie para .env (local) e cadastre as mesmas chaves em
# Vercel > Project > Settings > Environment Variables (Production e Preview).
# `vercel env pull .env.local` baixa as variáveis do projeto para rodar `vercel dev`.

# Asaas Checkout (obrigatório)
ASAAS_API_KEY=$aact_prod_xxx
ASAAS_ENV=production
ASAAS_WEBHOOK_TOKEN=gere-um-token-aleatorio-com-pelo-menos-32-caracteres
ASAAS_CHECKOUT_EXPIRATION_MINUTES=30
# ASAAS_MAX_INSTALLMENTS=10

# URL pública do site, usada nos callbacks do checkout (sucesso/cancelamento).
# Opcional na Vercel: sem ela o site usa o domínio da própria requisição.
# Defina quando houver domínio próprio, sem barra no final.
SITE_URL=https://seu-dominio.com.br

# Acesso ao /admin (obrigatório)
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio

# Supabase — banco de dados (confirmações de presença, presentes e pedidos). Obrigatório em produção.
# Configurado em lib/supabase.js. Sem ele, só o catálogo padrão funciona; RSVP, pedidos e admin respondem erro.
# Use a chave "secret" (Project Settings > API Keys). A service_role legada também funciona.
SUPABASE_URL=https://seu-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (alternativa legada à SUPABASE_SECRET_KEY)

# Só para as migrations no build (`scripts/deploy-db.js`) e `npm run migrate`.
# Opção A (recomendada): connection string do pooler (Project Settings > Database).
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-regiao.pooler.supabase.com:6543/postgres
# Opção B: Management API.
# SUPABASE_ACCESS_TOKEN=sbp_xxx
# SUPABASE_PROJECT_REF=seu-project-ref

# Pix direto (opcional; padrão embutido em api/pix-order.js)
# PIX_KEY=
# PIX_QR_CODE_IMAGE_URL=/assets/pix-qr-code.png

# Build (opcional)
# DB_DEPLOY_STRICT=true            falha o build se migrations/seed derem erro
# DB_DEPLOY_SEED_OVERWRITE=true    seed atualiza nome/preço/imagem dos presentes existentes
