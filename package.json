{
  "name": "karen-ph-casamento",
  "version": "1.0.0",
  "private": true,
  "description": "Wedding website for Karen and Paulo Henrique with Asaas Checkout and gift admin APIs.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run check && node scripts/deploy-db.js",
    "dev": "vercel dev",
    "start": "vercel dev",
    "migrate": "node scripts/migrate-supabase.js",
    "seed:gifts": "node scripts/seed-gifts.js",
    "seed:gifts:sql": "node scripts/seed-gifts.js --sql",
    "check": "for f in scripts/*.js lib/*.js api/*.js; do node --check \"$f\" || exit 1; done",
    "db:deploy": "node scripts/deploy-db.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0"
  }
}
